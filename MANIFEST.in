include README.md
include LICENSE
include requirements.txt
include pyproject.toml
recursive-include src/flask_admin_pro/templates *.html
recursive-include src/flask_admin_pro/static *.css *.js *.png *.jpg *.gif
recursive-include src/flask_admin_pro/static/css *.css
recursive-include src/flask_admin_pro/static/js *.js
global-exclude *.pyc
global-exclude *.pyo
global-exclude __pycache__
global-exclude .gitignore
global-exclude .env
global-exclude *.db
global-exclude instance/*
